---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import PostGrid from '../../components/PostGrid.astro';
import PageLinks from '../../components/PageLinks.astro';
import { queryPosts } from '../../lib/graphql';
import { defaultOgImage, socialImageHead } from '../../lib/head';
import { dateRangeTitle } from '../../lib/dates';

// Mirrors gatsby-node.js: page 1 is the root page (src/pages/index.astro,
// which keeps its own 10-post layout), pages 2..N are created here at /page/N
// and list 30 posts each in a 3-per-row grid.
const HOME_COUNT = 10;
const PER_PAGE = 30;
const pageCountOf = (total: number) =>
  total <= HOME_COUNT ? 1 : 1 + Math.ceil((total - HOME_COUNT) / PER_PAGE);

export async function getStaticPaths() {
  // NOTE: getStaticPaths is bundled separately — no module-level consts here.
  const result = await queryPosts(`
    {
      allPosts(filter: { is_archived: false }, sort: DESC) {
        slug
      }
    }
  `);
  if (result.errors) throw new Error(JSON.stringify(result.errors, null, 2));
  const total = result.data!.allPosts.length;
  const pageCount = total <= 10 ? 1 : 1 + Math.ceil((total - 10) / 30);
  return Array.from({ length: pageCount - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const currentPage = Number(Astro.params.page);
const offset = HOME_COUNT + (currentPage - 2) * PER_PAGE;
const result = await queryPosts(`
  {
    all: allPosts(filter: { is_archived: false }, sort: DESC) {
      slug
    }
    page: allPosts(filter: { is_archived: false }, sort: DESC, limit: ${PER_PAGE}, offset: ${offset}) {
      slug
      excerpt
      frontmatter {
        title
        date
        author
        image
        tags
      }
    }
  }
`);
if (result.errors) throw new Error(JSON.stringify(result.errors, null, 2));
const total = result.data!.all.length;
const pageCount = pageCountOf(total);
const posts = result.data!.page;

const site = Astro.site ?? new URL('https://en.socratic.dev');
// Title is the datetime range of the posts on this page (oldest → latest).
const title = dateRangeTitle(posts) || `Posts — page ${currentPage} of ${pageCount}`;
const description = 'A blog about technology and philosophy, newest posts first.';
---

<StarlightPage
  hasSidebar={false}
  frontmatter={{
    title,
    description,
    head: socialImageHead({ image: defaultOgImage(site), title, description }),
  }}
>
  <PostGrid posts={posts} />
  <PageLinks currentPage={currentPage} numberOfPages={pageCount} />
</StarlightPage>
