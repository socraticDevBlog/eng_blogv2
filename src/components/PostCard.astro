---
import { slugify } from '../lib/slugify';

const { post } = Astro.props;
const fm = post.frontmatter;
const href = `/posts/${post.slug}/`;
---

<article class="post-card">
  {
    fm.image && (
      <a href={href} class="post-card-image">
        <img src={fm.image} alt={fm.title} loading="lazy" />
      </a>
    )
  }
  <div class="post-card-body">
    <h2 class="post-card-title"><a href={href}>{fm.title}</a></h2>
    <p class="post-card-meta">
      <span>{fm.date}</span> by <span>{fm.author}</span>
    </p>
    <p class="post-card-excerpt">{post.excerpt}</p>
    {
      fm.tags?.length > 0 && (
        <ul class="post-card-tags not-content">
          {fm.tags.map((tag) => (
            <li>
              <a href={`/tag/${slugify(tag)}/`}>{tag}</a>
            </li>
          ))}
        </ul>
      )
    }
    <a href={href} class="post-card-more">Read more</a>
  </div>
</article>

<style>
  .post-card {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
    margin-bottom: 1.5rem;
    background: var(--sl-color-bg);
  }
  .post-card-image img {
    display: block;
    width: 100%;
    height: 300px;
    object-fit: cover;
  }
  .post-card-body {
    padding: 1rem 1.25rem 1.25rem;
  }
  .post-card-title {
    margin: 0 0 0.25rem;
    font-size: 1.4rem;
  }
  .post-card-title a {
    color: var(--sl-color-text);
    text-decoration: none;
  }
  .post-card-title a:hover {
    color: var(--sl-color-accent);
  }
  .post-card-meta {
    color: var(--sl-color-gray-3);
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
  }
  .post-card-excerpt {
    margin: 0 0 0.75rem;
  }
  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0 0 0.75rem;
  }
  .post-card-tags li {
    margin: 0;
    background: var(--sl-color-accent);
    color: #fff;
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    font-size: 0.8rem;
    line-height: 1.4;
  }
  .post-card-tags a {
    color: #fff;
    text-decoration: none;
  }
  .post-card-tags a:hover {
    text-decoration: underline;
  }
  .post-card-more {
    display: inline-block;
    border: 1px solid var(--sl-color-accent);
    color: var(--sl-color-accent);
    border-radius: 0.375rem;
    padding: 0.3rem 0.8rem;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .post-card-more:hover {
    background: var(--sl-color-accent);
    color: #fff;
  }
</style>
