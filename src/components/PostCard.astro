---
import { slugify } from '../lib/slugify';
import { formatDateEn } from '../lib/dates';

// `compact` = grid variant used on the listing pages (/page/N, /tag/…, /posts/…).
// The home page keeps the full-size, single-column cards.
const { post, compact = false } = Astro.props;
const fm = post.frontmatter;
const href = `/posts/${post.slug}/`;
// Long format with weekday, e.g. "Saturday, February 28, 2026" — no raw ISO dates.
const dateEn = formatDateEn(fm.date, true);
---

<article class:list={['post-card', { compact }]}>
  {
    fm.image && (
      <a href={href} class="post-card-image">
        <img src={fm.image} alt={fm.title} loading="lazy" />
      </a>
    )
  }
  <div class="post-card-body">
    <h2 class="post-card-title"><a href={href}>{fm.title}</a></h2>
    <p class="post-card-meta">
      <span>{dateEn}</span> by <span>{fm.author}</span>
    </p>
    <p class="post-card-excerpt">{post.excerpt}</p>
    {
      fm.tags?.length > 0 && (
        <ul class="post-card-tags not-content">
          {fm.tags.map((tag) => (
            <li>
              <a href={`/tag/${slugify(tag)}/`}>{tag}</a>
            </li>
          ))}
        </ul>
      )
    }
    <a href={href} class="post-card-more">Read more</a>
  </div>
</article>

<style>
  .post-card {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
    margin-bottom: 1.5rem;
    background: var(--sl-color-bg);
  }
  .post-card-image img {
    display: block;
    width: 100%;
    height: 300px;
    object-fit: cover;
  }
  .post-card-body {
    padding: 1rem 1.25rem 1.25rem;
  }
  .post-card-title {
    margin: 0 0 0.25rem;
    font-size: 1.4rem;
  }
  .post-card-title a {
    color: var(--sl-color-text);
    text-decoration: none;
  }
  .post-card-title a:hover {
    color: var(--sl-color-accent);
  }
  .post-card-meta {
    color: var(--sl-color-gray-3);
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
  }
  .post-card-excerpt {
    margin: 0 0 0.75rem;
  }
  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0 0 0.75rem;
  }
  .post-card-tags li {
    margin: 0;
    background: var(--sl-color-accent);
    color: #fff;
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    font-size: 0.8rem;
    line-height: 1.4;
  }
  .post-card-tags a {
    color: #fff;
    text-decoration: none;
  }
  .post-card-tags a:hover {
    text-decoration: underline;
  }
  .post-card-more {
    display: inline-block;
    border: 1px solid var(--sl-color-accent);
    color: var(--sl-color-accent);
    border-radius: 0.375rem;
    padding: 0.3rem 0.8rem;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .post-card-more:hover {
    background: var(--sl-color-accent);
    color: #fff;
  }

  /* ---- compact (grid) variant ---- */
  .post-card.compact .post-card-image img {
    height: 10rem;
  }
  .post-card.compact .post-card-body {
    padding: 0.75rem 0.9rem 0.9rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .post-card.compact .post-card-title {
    font-size: 1.05rem;
  }
  .post-card.compact .post-card-meta {
    font-size: 0.78rem;
    margin-bottom: 0.5rem;
  }
  .post-card.compact .post-card-excerpt {
    font-size: 0.88rem;
    margin-bottom: 0.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-card.compact .post-card-tags {
    margin-bottom: 0.6rem;
  }
  .post-card.compact .post-card-tags li {
    font-size: 0.7rem;
  }
  .post-card.compact .post-card-more {
    margin-top: auto;
    align-self: flex-start;
    padding: 0.2rem 0.6rem;
    font-size: 0.8rem;
  }

  /* cards inside a grid stretch to equal height per row */
  :global(.post-grid) .post-card {
    margin-bottom: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
</style>
