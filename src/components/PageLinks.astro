---
// Same behaviour as the old site's src/components/page-links.js:
// page 1 lives at "/", other pages at "/page/N", prev/next disabled at the ends.
const { currentPage, numberOfPages } = Astro.props;
const isFirst = currentPage === 1;
const isLast = currentPage === numberOfPages;
const previousPage = currentPage - 1 === 1 ? '/' : `/page/${currentPage - 1}`;
const nextPage = `/page/${currentPage + 1}`;
const pageHref = (n: number) => (n === 1 ? '/' : `/page/${n}`);
const pages = Array.from({ length: numberOfPages }, (_, i) => i + 1);
---

<nav class="pagination" aria-label="Pagination">
  {
    isFirst ? (
      <span class="page-link disabled" aria-disabled="true">
        ‹ Prev
      </span>
    ) : (
      <a class="page-link" href={previousPage}>
        ‹ Prev
      </a>
    )
  }
  {
    pages.map((n) =>
      n === currentPage ? (
        <span class="page-link active" aria-current="page">
          {n}
        </span>
      ) : (
        <a class="page-link" href={pageHref(n)}>
          {n}
        </a>
      ),
    )
  }
  {
    isLast ? (
      <span class="page-link disabled" aria-disabled="true">
        Next ›
      </span>
    ) : (
      <a class="page-link" href={nextPage}>
        Next ›
      </a>
    )
  }
</nav>

<style>
  .pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    justify-content: center;
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
  }
  .page-link {
    display: inline-block;
    min-width: 2.2rem;
    text-align: center;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    padding: 0.35rem 0.6rem;
    text-decoration: none;
    color: var(--sl-color-text);
    background: var(--sl-color-bg);
  }
  a.page-link:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }
  .page-link.active {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: #fff;
  }
  .page-link.disabled {
    opacity: 0.45;
    cursor: default;
  }
</style>
